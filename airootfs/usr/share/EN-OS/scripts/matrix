#!/bin/bash
# Установка матричных обоев по умолчанию для всех рабочих столов

LOCK_FILE="$HOME/.matrix_wallpaper_installed"
CONFIG_FILE="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
CONFIG_FILE2="/root/.config/plasma-org.kde.plasma.desktop-appletsrc"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Функция для логирования
log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$SCRIPT_DIR/installation.log"
}

# Проверка, был ли скрипт уже выполнен
if [[ -f "$LOCK_FILE" ]]; then
    log_message "Скрипт уже был выполнен ранее (файл $LOCK_FILE существует). Выход."
    exit 0
fi

log_message "Начало установки матричных обоев..."

# Проверка существования конфигурационных файлов
check_config_files() {
    local files_missing=0

    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_message "ВНИМАНИЕ: Конфигурационный файл $CONFIG_FILE не найден"
        files_missing=$((files_missing + 1))
    fi

    if [[ ! -f "$CONFIG_FILE2" ]]; then
        log_message "ВНИМАНИЕ: Конфигурационный файл $CONFIG_FILE2 не найден"
        files_missing=$((files_missing + 1))
    fi

    return $files_missing
}

# Основная функция установки
install_matrix_wallpaper() {
    log_message "Перезапуск plasmashell..."
    plasmashell --replace >/dev/null 2>&1 &

    # Ожидание инициализации plasmashell
    sleep 3

    # Проверяем существование файлов перед редактированием
    check_config_files
    local missing_files=$?

    if [[ $missing_files -eq 2 ]]; then
        log_message "ОШИБКА: Оба конфигурационных файла отсутствуют. Установка невозможна."
        return 1
    fi

    # Изменение конфигурации для текущего пользователя
    if [[ -f "$CONFIG_FILE" ]]; then
        if grep -q "wallpaperplugin=org.kde.image" "$CONFIG_FILE"; then
            sed -i 's/wallpaperplugin=org.kde.image/wallpaperplugin=obsidianreq.plasma.wallpaper.matrixrain/g' "$CONFIG_FILE"
            log_message "Обновлен конфигурационный файл: $CONFIG_FILE"
        else
            log_message "Шаблон wallpaperplugin=org.kde.image не найден в $CONFIG_FILE"
        fi
    fi

    # Изменение конфигурации для root (требует sudo)
    if [[ -f "$CONFIG_FILE2" ]]; then
        if sudo grep -q "wallpaperplugin=org.kde.image" "$CONFIG_FILE2"; then
            sudo sed -i 's/wallpaperplugin=org.kde.image/wallpaperplugin=obsidianreq.plasma.wallpaper.matrixrain/g' "$CONFIG_FILE2"
            log_message "Обновлен конфигурационный файл: $CONFIG_FILE2"
        else
            log_message "Шаблон wallpaperplugin=org.kde.image не найден в $CONFIG_FILE2"
        fi
    fi

    log_message "Финальный перезапуск plasmashell..."
    plasmashell --replace >/dev/null 2>&1 &

    # Создаем файл-флаг о выполнении скрипта
    echo "1" > "$LOCK_FILE"
    log_message "Установка завершена. Создан файл-флаг: $LOCK_FILE"

    # Запуск скрипта очистки, если он существует
    if [[ -f "$SCRIPT_DIR/rm-desktop" ]]; then
        log_message "Запуск скрипта очистки..."
        sudo bash "$SCRIPT_DIR/rm-desktop"
    else
        log_message "СКРИПТ ОЧИСТКИ НЕ НАЙДЕН: $SCRIPT_DIR/rm-desktop"
    fi

    return 0
}

# Обработка ошибок
set -e

# Запуск установки
if install_matrix_wallpaper; then
    log_message "Установка матричных обоев успешно завершена!"
else
    log_message "Установка матричных обоев завершилась с ошибками!"
    exit 1
fi
