dontChroot: false
timeout: 120

script:
    - |
      echo "=== BOOT MOUNT FIX ==="

      # Убедимся что /boot правильно смонтирован
      if mountpoint -q /boot; then
          echo "✓ /boot is mounted"
          ls -la /boot/
      else
          echo "⚠ /boot not mounted, attempting to mount"
          mount /boot 2>/dev/null || true
      fi

      # Проверяем что ядро на месте
      if [ -f "/boot/vmlinuz-linux" ]; then
          echo "✓ Kernel found in /boot"
      else
          echo "⚠ Kernel not found in /boot"
      fi

      echo "=== BOOT FIX COMPLETE ==="
